        {"param_name":"fecha","example":"12 de noviembre a las 3:00 p. m."} ] } },
    { "type": "buttons", "buttons": [
      {"type":"QUICK_REPLY","text":"Confirmo"},
      {"type":"QUICK_REPLY","text":"Reagendar"} ] }
  ]
}</code></pre></details>

<details><summary>JSON: enviar la plantilla</summary>
